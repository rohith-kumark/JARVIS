# ==========================================
# JARVIS Configuration Environment Variables
# ==========================================

# Application Settings
APP_NAME="JARVIS AI Assistant"
APP_ENV="development"
DEBUG=true

# Server Network Settings
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list in Pydantic)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# LLM Reasoning Engine Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Default Provider: "gemini" or "mock" (defaults to mock if key is empty)
DEFAULT_LLM_PROVIDER="gemini"

# Observability
LOG_LEVEL="INFO"
WS_HEARTBEAT_INTERVAL_SECONDS=30
