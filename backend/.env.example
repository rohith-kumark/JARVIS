# ==========================================
# JARVIS Configuration Environment Variables
# ==========================================

# Application Settings
APP_NAME="JARVIS AI Assistant"
APP_ENV="development"
DEBUG=true

# Server Network Settings
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list in Pydantic)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# LLM Reasoning Engine Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Default Provider: "gemini" or "mock" (defaults to mock if key is empty)
DEFAULT_LLM_PROVIDER="gemini"

# Database (PostgreSQL) Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="jarvis"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/jarvis"

# Vector Database Configuration (Open-Source: Embedded Persistent Vector Store / ChromaDB)
VECTOR_STORE_PATH="backend/data/vector_store"
VECTOR_STORE_TYPE="embedded"

# Observability
LOG_LEVEL="INFO"
WS_HEARTBEAT_INTERVAL_SECONDS=30
